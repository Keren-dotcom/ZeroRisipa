{
  "info": {
    "name": "ZeroRisipa API",
    "description": "Integration tests for the first deliverable: auth, pantry, ingredients, recipes.\nRun the folders in order (Collection Runner): Login saves the token automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "ingredientId",
      "value": ""
    },
    {
      "key": "ingredientName",
      "value": ""
    },
    {
      "key": "pantryItemId",
      "value": ""
    },
    {
      "key": "expiryDate",
      "value": ""
    },
    {
      "key": "recipeId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"API and database respond\", () => {",
                  "    pm.expect(pm.response.json()).to.eql({ status: \"ok\", database: \"ok\" });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// New email on every run, so the collection can be run any number of times.",
                  "pm.collectionVariables.set(\"email\", `student_${Date.now()}@example.com`);",
                  "pm.collectionVariables.set(\"password\", \"password123\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
                  "const user = pm.response.json();",
                  "pm.test(\"Response does not contain the password\", () => {",
                  "    pm.expect(user).to.have.all.keys(\"id\", \"email\", \"full_name\", \"is_active\", \"created_at\");",
                  "    pm.expect(user.email).to.eql(pm.collectionVariables.get(\"email\"));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"full_name\": \"Student Test\"\n}"
            }
          }
        },
        {
          "name": "Register - duplicate email",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"409 Conflict\", () => pm.response.to.have.status(409));",
                  "pm.test(\"Error message\", () => pm.expect(pm.response.json().detail).to.be.a(\"string\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            }
          }
        },
        {
          "name": "Register - password too short",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"422 Unprocessable Entity\", () => pm.response.to.have.status(422));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"short_{{$timestamp}}@example.com\",\n  \"password\": \"123\"\n}"
            }
          }
        },
        {
          "name": "Login - wrong password",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"401 Unauthorized\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"wrong123\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Returns a bearer token\", () => {",
                  "    pm.expect(body.token_type).to.eql(\"bearer\");",
                  "    pm.expect(body.access_token).to.be.a(\"string\").and.not.empty;",
                  "});",
                  "// The token is saved automatically and used by every protected request.",
                  "pm.environment.set(\"token\", body.access_token);",
                  "pm.collectionVariables.set(\"token\", body.access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            }
          }
        },
        {
          "name": "Me",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"It is the logged-in user\", () => {",
                  "    pm.expect(pm.response.json().email).to.eql(pm.collectionVariables.get(\"email\"));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            }
          }
        },
        {
          "name": "Me - no token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"401 Unauthorized\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "Ingredients",
      "item": [
        {
          "name": "Add ingredient",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"ingredientName\", `test ingredient ${Date.now()}`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
                  "const ing = pm.response.json();",
                  "pm.test(\"Ingredient structure\", () => {",
                  "    pm.expect(ing).to.have.all.keys(\"id\", \"name\", \"category\", \"default_unit\", \"is_custom\");",
                  "});",
                  "pm.test(\"Goes into your own catalogue\", () => pm.expect(ing.is_custom).to.eql(true));",
                  "pm.collectionVariables.set(\"ingredientId\", ing.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ingredients",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ingredients"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{ingredientName}}\",\n  \"category\": \"dairy\",\n  \"default_unit\": \"ml\"\n}"
            }
          }
        },
        {
          "name": "Search ingredients",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Finds the added ingredient\", () => {",
                  "    const names = pm.response.json().map(i => i.name);",
                  "    pm.expect(names).to.include(pm.collectionVariables.get(\"ingredientName\"));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/ingredients?q={{ingredientName}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ingredients"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "{{ingredientName}}"
                }
              ]
            }
          }
        },
        {
          "name": "Search ingredients - no login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Your own ingredients are not public\", () => {",
                  "    const names = pm.response.json().map(i => i.name);",
                  "    pm.expect(names).to.not.include(pm.collectionVariables.get(\"ingredientName\"));",
                  "});",
                  "pm.test(\"Only the shared catalogue\", () => {",
                  "    pm.response.json().forEach(i => pm.expect(i.is_custom).to.eql(false));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/ingredients?q={{ingredientName}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ingredients"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "{{ingredientName}}"
                }
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "Pantry",
      "item": [
        {
          "name": "Add to pantry",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Expires in 2 days, so it shows up in the \"expiring soon\" filter.",
                  "const d = new Date(Date.now() + 2 * 24 * 3600 * 1000);",
                  "pm.collectionVariables.set(\"expiryDate\", d.toISOString().slice(0, 10));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
                  "const item = pm.response.json();",
                  "pm.test(\"Pantry item structure\", () => {",
                  "    pm.expect(item).to.include.keys(\"id\", \"ingredient\", \"quantity\", \"unit\", \"expiry_date\");",
                  "    pm.expect(item.ingredient.id).to.eql(Number(pm.collectionVariables.get(\"ingredientId\")));",
                  "});",
                  "pm.collectionVariables.set(\"pantryItemId\", item.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/pantry",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pantry"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ingredient_id\": \"{{ingredientId}}\",\n  \"quantity\": 500,\n  \"unit\": \"ml\",\n  \"expiry_date\": \"{{expiryDate}}\"\n}"
            }
          }
        },
        {
          "name": "Add to pantry - quantity 0",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"422 Unprocessable Entity\", () => pm.response.to.have.status(422));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/pantry",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pantry"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ingredient_id\": \"{{ingredientId}}\",\n  \"quantity\": 0,\n  \"unit\": \"ml\",\n  \"expiry_date\": \"{{expiryDate}}\"\n}"
            }
          }
        },
        {
          "name": "List pantry",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const items = pm.response.json();",
                  "pm.test(\"Contains the added item\", () => {",
                  "    pm.expect(items.map(i => i.id)).to.include(Number(pm.collectionVariables.get(\"pantryItemId\")));",
                  "});",
                  "pm.test(\"Sorted by expiry date\", () => {",
                  "    const dates = items.map(i => i.expiry_date);",
                  "    pm.expect(dates).to.eql([...dates].sort());",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/pantry?sort=expiry_date",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pantry"
              ],
              "query": [
                {
                  "key": "sort",
                  "value": "expiry_date"
                }
              ]
            }
          }
        },
        {
          "name": "Expiring within 3 days",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"The item shows up in the filter\", () => {",
                  "    const ids = pm.response.json().map(i => i.id);",
                  "    pm.expect(ids).to.include(Number(pm.collectionVariables.get(\"pantryItemId\")));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/pantry?expiring_within_days=3",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pantry"
              ],
              "query": [
                {
                  "key": "expiring_within_days",
                  "value": "3"
                }
              ]
            }
          }
        },
        {
          "name": "Pantry item detail",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Same quantity\", () => pm.expect(pm.response.json().quantity).to.eql(\"500.00\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/pantry/{{pantryItemId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pantry",
                "{{pantryItemId}}"
              ]
            }
          }
        },
        {
          "name": "Update quantity",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Quantity is updated\", () => pm.expect(pm.response.json().quantity).to.eql(\"250.00\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/pantry/{{pantryItemId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pantry",
                "{{pantryItemId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 250\n}"
            }
          }
        },
        {
          "name": "Pantry - no token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"401 Unauthorized\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/pantry",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pantry"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Delete pantry item",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"204 No Content\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/pantry/{{pantryItemId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pantry",
                "{{pantryItemId}}"
              ]
            }
          }
        },
        {
          "name": "Deleted pantry item detail",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"404 Not Found\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/pantry/{{pantryItemId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pantry",
                "{{pantryItemId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Recipes",
      "item": [
        {
          "name": "List recipes",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const page = pm.response.json();",
                  "pm.test(\"Pagination structure\", () => {",
                  "    pm.expect(page).to.have.all.keys(\"items\", \"total\", \"limit\", \"offset\");",
                  "    pm.expect(page.limit).to.eql(5);",
                  "    pm.expect(page.items.length).to.be.at.most(5);",
                  "});",
                  "// If the seed was not run, the list is empty and the detail request is skipped.",
                  "pm.collectionVariables.set(\"recipeId\", page.items.length ? page.items[0].id : \"\");"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/recipes?limit=5&offset=0",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "recipes"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "5"
                },
                {
                  "key": "offset",
                  "value": "0"
                }
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Recipe detail",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get(\"recipeId\")) {",
                  "    console.log(\"No recipes found (run python -m app.seed); skipping the detail request.\");",
                  "    pm.execution.skipRequest();",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const recipe = pm.response.json();",
                  "pm.test(\"Has instructions and ingredients\", () => {",
                  "    pm.expect(recipe.instructions).to.be.a(\"string\").and.not.empty;",
                  "    pm.expect(recipe.ingredients).to.be.an(\"array\").and.not.empty;",
                  "    pm.expect(recipe.ingredients[0]).to.have.all.keys(\"ingredient\", \"quantity\", \"unit\");",
                  "});"
                ]
              }
