# Copy this file to .env and adjust the values as needed.
POSTGRES_USER=zerorisipa
POSTGRES_PASSWORD=zerorisipa
POSTGRES_DB=zerorisipa
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

APP_ENV=dev
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Key used to sign JWT tokens. Generate one with: openssl rand -hex 32
JWT_SECRET_KEY=change-me-in-env
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Optional: full database URL (used in production, e.g. Neon). Overrides the POSTGRES_* values above.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
