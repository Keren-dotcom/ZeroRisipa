# Copiază fișierul în .env și modifică valorile după nevoie.
POSTGRES_USER=zerorisipa
POSTGRES_PASSWORD=zerorisipa
POSTGRES_DB=zerorisipa
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

APP_ENV=dev
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Cheie pentru semnarea tokenurilor JWT. Generează una cu: openssl rand -hex 32
JWT_SECRET_KEY=schimba-ma-in-env
ACCESS_TOKEN_EXPIRE_MINUTES=60
